[Unit]
Description=Daily scrollreel build (backstop for GitHub's scheduler)

[Timer]
# 12:30 local, an hour after GitHub's own 08:23 UTC slot. If GitHub fired, the
# script sees today's run and does nothing; if it did not, this is the build.
OnCalendar=*-*-* 12:30:00
# The machine is a laptop and will be off at 12:30 on some days. Persistent
# means the timer fires as soon as it comes back rather than skipping the day,
# which is the entire reason a laptop timer is worth anything.
Persistent=true
RandomizedDelaySec=300
Unit=scrollreel-daily.service

[Install]
WantedBy=timers.target
