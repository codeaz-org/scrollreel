# --- Required ---

# aistudio.google.com/app/apikey -- free tier. Builds the website itself.
# gemini-3.8-flash is listed first in page_builder.MODELS but has failed on
# every call so far; 3.5-flash catches it. Left in the chain deliberately.
GEMINI_API_KEY=

# pexels.com/api -- free. Photographs for the business site. Without it the
# pipeline falls back to Picsum, and without that it tells the builder to draw
# in CSS rather than leave holes in the layout.
PEXELS_API_KEY=

# --- Posting (TikTok via Buffer, drafts only) ---
# publish.buffer.com/settings/api. Connect TikTok under Channels first.
BUFFER_ACCESS_TOKEN=
# Only needed with more than one TikTok channel on the account.
BUFFER_CHANNEL_ID_CODEAZ=
# Left at 1 on purpose: every video is staged as a Buffer draft for a human to
# approve. These are concept sites for fictional businesses -- nothing should
# reach the account without someone looking at it first.
BUFFER_DRAFT=1

# --- Optional ---
# Raises the GitHub API limit from 60/hour to 5000 when listing component
# registries, and is what buffer hosting uses to publish the clip as a release
# asset so Buffer can fetch it by URL. In Actions this is provided already.
# GITHUB_TOKEN=
# GITHUB_REPOSITORY=codeaz-org/scrollreel
